// Prisma Schema
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Schedule {
  id          Int      @id @default(autoincrement())
  date        DateTime
  endDate     DateTime?
  projectName String
  teamName    String
  peopleCount Int
  members     String
  shift       String   @default("เช้า")
  notes       String?
  color       String   @default("#3B82F6")
  createdAt   DateTime @default(now())
}

model Leave {
  id        Int      @id @default(autoincrement())
  name      String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
}

model Member {
  id        Int      @id @default(autoincrement())
  name      String
  role      String?
  createdAt DateTime @default(now())
}

model Project {
  id        Int      @id @default(autoincrement())
  name      String
  color     String   @default("#3B82F6")
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model ProjectMilestone {
  id          Int      @id @default(autoincrement())
  projectName String
  label       String
  date        DateTime
  status      String   @default("pending")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model MilestoneStatus {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  label     String
  color     String   @default("#6B7280")
  bgColor   String   @default("#F3F4F6")
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model CompanyHoliday {
  id        Int      @id @default(autoincrement())
  date      DateTime
  name      String
  color     String   @default("#FEF3C7")
  createdAt DateTime @default(now())
}

model ProjectTask {
  id          Int            @id @default(autoincrement())
  projectName String
  title       String
  month       String
  dueDate     DateTime?
  done        Boolean        @default(false)
  order       Int            @default(0)
  parentId    Int?
  members     String?
  scheduleId  Int?
  parent      ProjectTask?   @relation("SubTasks", fields: [parentId], references: [id], onDelete: Cascade)
  children    ProjectTask[]  @relation("SubTasks")
  createdAt   DateTime       @default(now())
}

model StockWatch {
  id        Int      @id @default(autoincrement())
  symbol    String   @unique
  label     String?
  createdAt DateTime @default(now())
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}